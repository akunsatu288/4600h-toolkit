[Unit]
Description=RyzenAdj for Ryzen 5 4600H (BIOS TDP 54W, CO -15)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ryzenadj --stapm-limit=54000 --fast-limit=54000 --slow-limit=54000 --apu-slow-limit=54000 --tdc-vdd=58000 --edc-vdd=96000 --thm-limit=95000 --set-coall=-15
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
